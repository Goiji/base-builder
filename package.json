{
  "name": "@goiji/base-builder",
  "version": "1.0.0",
  "description": "Toolkit for building and deploying EVM smart contracts on Base.",
  "license": "MIT",
  "keywords": ["base", "evm", "solidity", "foundry", "smart-contracts"],
  "scripts": {
    "build": "forge build",
    "test": "forge test -vvv",
    "fmt": "forge fmt",
    "lint": "solhint \"src/**/*.sol\" \"libraries/**/*.sol\"",
    "deploy:base": "forge script script/DeployBaseERC20.s.sol --rpc-url $BASE_RPC --broadcast",
    "deploy:sepolia": "forge script script/DeployAirdrop.s.sol --rpc-url $BASE_SEPOLIA_RPC --broadcast",
    "merkle": "node tooling/generate-merkle.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "ethers": "^6.13.0",
    "solhint": "^5.0.0",
    "prettier": "^3.3.0",
    "hardhat": "^2.22.0"
  }
}
